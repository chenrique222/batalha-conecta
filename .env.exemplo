# Copie este arquivo com o nome .env (ou execute configurar_ia.py) para ativar
# o assistente de IA gratuito do cadastro por voz. O .env não deve ser compartilhado.

# Chave gratuita criada em https://console.groq.com/keys
GROQ_API_KEY=

# Opcional: nomes de bairros, povoados e produtos da região, separados por vírgula.
# Ajudam a IA a escrever certo o que ouviu. Exemplo com nomes inventados:
# BATALHA_IA_VOCABULARIO=Bairro Exemplo, Povoado Exemplo, beiju, puba

# Opcional: troque os modelos se a Groq mudar a lista do plano gratuito.
# BATALHA_IA_MODELO_ESCUTA=whisper-large-v3
# BATALHA_IA_MODELOS_TEXTO=openai/gpt-oss-20b,openai/gpt-oss-120b

# Página do professor (/moderacao) para apagar perfis e avaliações.
# Sem esta linha, a página não existe. Use pelo menos 8 caracteres e não compartilhe.
# BATALHA_MODERACAO_SENHA=
